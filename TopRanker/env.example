# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY CONFIGURATION (Test or Live mode)
# RAZORPAY_KEY_ID: Public Key ID (e.g., rzp_test_xxxxxxxxxxxx)
RAZORPAY_KEY_ID="rzp_test_mock_jee30"

# RAZORPAY_KEY_SECRET: Private Secret (keep server-side only)
RAZORPAY_KEY_SECRET="mock_secret_jee30_test_mode"

# RAZORPAY_WEBHOOK_SECRET: Secret for verifying Razorpay Webhook signatures
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret_jee30"

# JWT_SECRET: Secret used to sign authentication tokens
JWT_SECRET="jee_pyq_30_jwt_secure_key_prod"

# SMTP EMAIL CONFIGURATION (Optional - for sending real emails via Gmail, SendGrid, Amazon SES, Resend, etc.)
# If not set, system operates in smart sandbox preview mode and securely displays OTP/notification logs.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@jeepyq.com"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="JEE PYQ 30 <notifications@jeepyq.com>"
